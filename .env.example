MCP_SERVER_NAME=gpt-parser-mcp
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_LOG_LEVEL=INFO
# Relative to this .env file; name/table.md will be stored here.
BASE_DIR=./data
# Maximum returned UTF-8 bytes (including source newlines) and number of lines.
MCP_MAX_RESULT_BYTES=1048576
MCP_MAX_RESULT_LINES=10000
# recall uses the QMD CLI; query = semantic/hybrid, search = BM25 only.
MCP_QMD_COMMAND=./.tools/qmd/node_modules/.bin/qmd
MCP_QMD_MODE=query
MCP_QMD_CACHE_HOME=./.cache
MCP_QMD_TIMEOUT=300
MCP_RECALL_CHUNK_BYTES=8192
